<Application x:Class="Owmeta.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Owmeta">
    <!-- Loaded once for the app: templates instantiated per analysis row must not
         re-parse the theme on every instance. -->
    <Application.Resources>
        <ResourceDictionary Source="/OWMetaHUD;component/Display/Theme.xaml"/>
    </Application.Resources>
</Application>
