<Project Sdk="Microsoft.NET.Sdk">
  <!-- Scoreboard recognition engine: frame preparation, portrait encoder (ONNX Runtime) and OCR
       (Tesseract). A plain library rather than part of the WPF project, whose implicit usings
       omit System.IO. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Owmeta.Vision</AssemblyName>
    <RootNamespace>Owmeta.Vision</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.24.4" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
    <PackageReference Include="Tesseract" Version="5.2.0" />
  </ItemGroup>
</Project>
