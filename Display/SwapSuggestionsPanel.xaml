<UserControl x:Class="Owmeta.Display.SwapSuggestionsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Owmeta.Display">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/OWMetaHUD;component/Display/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Columns shared by the header band and every row -->
            <GridLength x:Key="Col.Portrait">80</GridLength>
            <GridLength x:Key="Col.Also">330</GridLength>
            <GridLength x:Key="Col.Score">160</GridLength>
            <GridLength x:Key="Col.Counters">310</GridLength>
            <GridLength x:Key="Col.CounteredBy">290</GridLength>
            <GridLength x:Key="Col.Synergy">240</GridLength>

            <DataTemplate DataType="{x:Type local:SwapGroupViewModel}">
                <Border Height="52" Margin="0,4,0,0" Background="{Binding Background}"
                        BorderBrush="{Binding Color}" BorderThickness="8,0,0,0">
                    <Grid>
                        <TextBlock Text="{Binding Name}" Foreground="{Binding Color}" Style="{StaticResource Hud.Board}"
                                   FontSize="34" Margin="24,0,0,0"/>
                        <Path Data="M0,20 L12,0 L24,20 Z" Fill="{Binding Color}" Visibility="{Binding MarkerVisibility}"
                              HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,28,0"/>
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate DataType="{x:Type local:SwapRowViewModel}">
                <Border Height="80" Background="{Binding Background}" BorderBrush="#59000000" BorderThickness="0,0,0,2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource Col.Portrait}"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="{StaticResource Col.Also}"/>
                            <ColumnDefinition Width="{StaticResource Col.Score}"/>
                            <ColumnDefinition Width="{StaticResource Col.Counters}"/>
                            <ColumnDefinition Width="{StaticResource Col.CounteredBy}"/>
                            <ColumnDefinition Width="{StaticResource Col.Synergy}"/>
                        </Grid.ColumnDefinitions>
                        <local:HeroAvatar Source="{Binding Icon}" Width="78" Height="78" CornerRatio="0" ShowPip="False"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Hud.Board}" FontSize="42" Margin="24,0,12,0"/>
                        <ItemsControl Grid.Column="2" ItemsSource="{Binding AlsoFits}" ItemsPanel="{StaticResource Hud.HorizontalPanel}"
                                      VerticalAlignment="Center" Margin="20,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" Style="{StaticResource Hud.Board}"
                                               FontSize="26" Margin="0,0,18,0"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Grid.Column="3" Text="{Binding ScoreText}" Foreground="{Binding ScoreBrush}" Style="{StaticResource Hud.BoardStat}"/>
                        <ItemsControl Grid.Column="4" ItemsSource="{Binding Counters}" ItemTemplate="{StaticResource Hud.BoardIcon}"
                                      ItemsPanel="{StaticResource Hud.HorizontalPanel}" VerticalAlignment="Center" Margin="20,0,0,0"/>
                        <ItemsControl Grid.Column="5" ItemsSource="{Binding CounteredBy}" ItemTemplate="{StaticResource Hud.BoardIcon}"
                                      ItemsPanel="{StaticResource Hud.HorizontalPanel}" VerticalAlignment="Center" Margin="20,0,0,0"/>
                        <ItemsControl Grid.Column="6" ItemsSource="{Binding Synergies}" ItemTemplate="{StaticResource Hud.BoardIcon}"
                                      ItemsPanel="{StaticResource Hud.HorizontalPanel}" VerticalAlignment="Center" Margin="20,0,0,0"/>
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <local:CompositionHeader x:Name="Header"/>
        <local:ThreatBar x:Name="Threat"/>

        <!-- Shown instead of the table when the player's hero is not known -->
        <Border x:Name="NoticeCard" Background="{x:Static local:HudPalette.Strip}" Margin="0,4,0,0" Padding="40,26" Visibility="Collapsed">
            <TextBlock x:Name="NoticeText" Style="{StaticResource Hud.Board}" FontSize="34" Foreground="{x:Static local:HudPalette.TextSecondary}"/>
        </Border>

        <StackPanel x:Name="SwapSection" Visibility="Collapsed">
            <Border Background="{x:Static local:HudPalette.ColumnBand}" Height="52" Margin="0,4,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource Col.Portrait}"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="{StaticResource Col.Also}"/>
                        <ColumnDefinition Width="{StaticResource Col.Score}"/>
                        <ColumnDefinition Width="{StaticResource Col.Counters}"/>
                        <ColumnDefinition Width="{StaticResource Col.CounteredBy}"/>
                        <ColumnDefinition Width="{StaticResource Col.Synergy}"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="HERO" Style="{StaticResource Hud.ColumnLabel}" Margin="24,0"/>
                    <TextBlock Grid.Column="3" Text="SCORE" Style="{StaticResource Hud.ColumnLabel}" HorizontalAlignment="Center" Margin="0"/>
                    <TextBlock Grid.Column="4" Text="COUNTERS" Style="{StaticResource Hud.ColumnLabel}"/>
                    <TextBlock Grid.Column="5" Text="COUNTERED BY" Style="{StaticResource Hud.ColumnLabel}"/>
                    <TextBlock Grid.Column="6" Text="SYNERGY" Style="{StaticResource Hud.ColumnLabel}"/>
                </Grid>
            </Border>

            <ItemsControl x:Name="SuggestionsControl"/>

            <Border x:Name="NoSwapsCard" Background="{x:Static local:HudPalette.RowA}" Height="80" Visibility="Collapsed">
                <TextBlock x:Name="NoSwapsText" Style="{StaticResource Hud.Board}" FontSize="32"
                           Foreground="{x:Static local:HudPalette.TextSecondary}" Margin="104,0,0,0"/>
            </Border>

            <Border x:Name="MoreCard" Background="{x:Static local:HudPalette.Strip}" Height="44" Visibility="Collapsed">
                <TextBlock x:Name="MoreText" Style="{StaticResource Hud.Board}" FontSize="24"
                           Foreground="{x:Static local:HudPalette.BoardLabel}" Margin="104,0,0,0"/>
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>
