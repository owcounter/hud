<UserControl x:Class="Owmeta.Display.SwapSuggestionsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Owmeta.Display">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/OWMetaHUD;component/Display/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Columns shared by the list title and every row -->
            <GridLength x:Key="Col.Portrait">96</GridLength>
            <GridLength x:Key="Col.Score">150</GridLength>
            <GridLength x:Key="Col.Counters">340</GridLength>
            <GridLength x:Key="Col.CounteredBy">340</GridLength>
            <GridLength x:Key="Col.Fits">390</GridLength>

            <DataTemplate DataType="{x:Type local:SwapGroupViewModel}">
                <Border Height="52" Margin="0,4,0,0" Background="{Binding Background}"
                        BorderBrush="{Binding Color}" BorderThickness="8,0,0,0">
                    <Grid>
                        <TextBlock Text="{Binding Name}" Foreground="{Binding Color}" Style="{StaticResource Hud.Board}"
                                   FontSize="34" Margin="24,0,0,0"/>
                        <Path Data="M0,20 L12,0 L24,20 Z" Fill="{Binding Color}" Visibility="{Binding MarkerVisibility}"
                              HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,28,0"/>
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate DataType="{x:Type local:SwapRowViewModel}">
                <Border Height="88" Background="{Binding Background}" BorderBrush="{Binding EdgeBrush}" BorderThickness="8,0,0,2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource Col.Portrait}"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="{StaticResource Col.Score}"/>
                            <ColumnDefinition Width="{StaticResource Col.Counters}"/>
                            <ColumnDefinition Width="{StaticResource Col.CounteredBy}"/>
                            <ColumnDefinition Width="{StaticResource Col.Fits}"/>
                        </Grid.ColumnDefinitions>
                        <local:HeroAvatar Source="{Binding Icon}" Width="80" Height="80" CornerRatio="0.06" ShowPip="False" Margin="4,0,0,0"
                                          Accent="{Binding EdgeAccent}" RingThickness="3"/>
                        <Grid Grid.Column="1" Margin="28,0,12,0" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" Style="{StaticResource Hud.Board}" FontSize="44"/>
                            <TextBlock Grid.Column="1" Text="YOU" Visibility="{Binding YouVisibility}" Style="{StaticResource Hud.Board}" FontSize="24"
                                       Foreground="{x:Static local:HudPalette.Ally}" Margin="16,8,0,0"/>
                        </Grid>
                        <TextBlock Grid.Column="2" Text="{Binding ScoreText}" Foreground="{Binding ScoreBrush}" Style="{StaticResource Hud.Board}"
                                   FontSize="48" HorizontalAlignment="Right" Margin="0,0,28,0"/>
                        <ItemsControl Grid.Column="3" ItemsSource="{Binding Counters}" ItemTemplate="{StaticResource Hud.BoardIcon}"
                                      ItemsPanel="{StaticResource Hud.HorizontalPanel}" VerticalAlignment="Center"/>
                        <ItemsControl Grid.Column="4" ItemsSource="{Binding CounteredBy}" ItemTemplate="{StaticResource Hud.BoardIcon}"
                                      ItemsPanel="{StaticResource Hud.HorizontalPanel}" VerticalAlignment="Center"/>
                        <ItemsControl Grid.Column="5" ItemsSource="{Binding Fits}" ItemTemplate="{StaticResource Hud.FitWord}"
                                      ItemsPanel="{StaticResource Hud.HorizontalPanel}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <local:CompositionHeader x:Name="Header"/>

        <!-- Shown instead of the swaps when the player's hero is not known -->
        <Border x:Name="NoticeCard" Background="{x:Static local:HudPalette.Strip}" Margin="0,4,0,0" Padding="40,26" Visibility="Collapsed">
            <TextBlock x:Name="NoticeText" Style="{StaticResource Hud.Board}" FontSize="34" Foreground="{x:Static local:HudPalette.TextSecondary}"/>
        </Border>

        <StackPanel x:Name="SwapSection" Visibility="Collapsed">
            <!-- Column labels, shared by your hero and the swap suggestions -->
            <Border Background="{x:Static local:HudPalette.GroupBand}" Height="52" Margin="0,4,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource Col.Portrait}"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="{StaticResource Col.Score}"/>
                        <ColumnDefinition Width="{StaticResource Col.Counters}"/>
                        <ColumnDefinition Width="{StaticResource Col.CounteredBy}"/>
                        <ColumnDefinition Width="{StaticResource Col.Fits}"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.ColumnSpan="3" Text="YOUR HERO" Style="{StaticResource Hud.Board}" FontSize="26" Margin="24,0,0,0"/>
                    <TextBlock Grid.Column="3" Text="COUNTERS" Style="{StaticResource Hud.Board}" FontSize="26" Foreground="{x:Static local:HudPalette.Good}"/>
                    <TextBlock Grid.Column="4" Text="COUNTERED BY" Style="{StaticResource Hud.Board}" FontSize="26" Foreground="{x:Static local:HudPalette.Bad}"/>
                    <TextBlock Grid.Column="5" Text="GOOD IN" Style="{StaticResource Hud.Board}" FontSize="26" Foreground="{x:Static local:HudPalette.BoardLabel}"/>
                </Grid>
            </Border>

            <!-- Your hero: the same columns as the swaps, so each one compares directly -->
            <ContentControl x:Name="CurrentRow" Focusable="False"/>

            <Border Background="{x:Static local:HudPalette.GroupBand}" Height="48">
                <TextBlock Text="SWAP SUGGESTIONS" Style="{StaticResource Hud.Board}" FontSize="26" Margin="24,0,0,0"/>
            </Border>

            <ItemsControl x:Name="SuggestionsControl"/>

            <Border x:Name="NoSwapsCard" Background="{x:Static local:HudPalette.RowA}" Height="80" Visibility="Collapsed">
                <TextBlock x:Name="NoSwapsText" Style="{StaticResource Hud.Board}" FontSize="32"
                           Foreground="{x:Static local:HudPalette.TextSecondary}" Margin="124,0,0,0"/>
            </Border>

            <Border x:Name="MoreCard" Background="{x:Static local:HudPalette.Strip}" Height="44" Visibility="Collapsed">
                <TextBlock x:Name="MoreText" Style="{StaticResource Hud.Board}" FontSize="24"
                           Foreground="{x:Static local:HudPalette.BoardLabel}" Margin="124,0,0,0"/>
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>
