<UserControl x:Class="Owmeta.Display.AvatarRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Owmeta.Display">
    <!-- Theme styles come from App resources; a per-instance merge re-parsed Theme.xaml
         for every row created by each analysis update. -->

    <!-- Labeled strip of hero avatars, e.g.  BEATS  [][][]  -->
    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LabelColumn" Width="92"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="LabelText" Style="{StaticResource Hud.RowLabel}"/>

        <ItemsControl x:Name="ItemsHost" Grid.Column="1" ItemsPanel="{StaticResource Hud.HorizontalPanel}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <local:HeroAvatar Source="{Binding Icon}"
                                      IsHard="{Binding IsHard}"
                                      Accent="{Binding Accent, RelativeSource={RelativeSource AncestorType=local:AvatarRow}}"
                                      Width="{Binding AvatarSize, RelativeSource={RelativeSource AncestorType=local:AvatarRow}}"
                                      Height="{Binding AvatarSize, RelativeSource={RelativeSource AncestorType=local:AvatarRow}}"
                                      Margin="0,0,6,0"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
