<UserControl x:Class="Owmeta.Display.CompositionDashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Owmeta.Display">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/OWMetaHUD;component/Display/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Roster columns -->
            <GridLength x:Key="Ros.Portrait">72</GridLength>
            <GridLength x:Key="Ros.Score">120</GridLength>
            <GridLength x:Key="Ros.Icons">330</GridLength>

            <!-- Team swap columns -->
            <GridLength x:Key="Sw.Pair">190</GridLength>
            <GridLength x:Key="Sw.Gain">140</GridLength>
            <GridLength x:Key="Sw.Counters">310</GridLength>
            <GridLength x:Key="Sw.CounteredBy">290</GridLength>
            <GridLength x:Key="Sw.Strong">300</GridLength>

            <DataTemplate DataType="{x:Type local:RosterRowViewModel}">
                <Border Height="72" Background="{Binding Background}" BorderBrush="{Binding EdgeBrush}" BorderThickness="6,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource Ros.Portrait}"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="{StaticResource Ros.Score}"/>
                            <ColumnDefinition Width="{StaticResource Ros.Icons}"/>
                        </Grid.ColumnDefinitions>
                        <local:HeroAvatar Source="{Binding Icon}" Width="72" Height="72" CornerRatio="0" ShowPip="False"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Hud.Board}" FontSize="36" Margin="20,0,8,0"/>
                        <TextBlock Grid.Column="2" Text="{Binding ScoreText}" Foreground="{Binding ScoreBrush}" Style="{StaticResource Hud.BoardStat}"/>
                        <ItemsControl Grid.Column="3" ItemsSource="{Binding Icons}" ItemTemplate="{StaticResource Hud.BoardIcon}"
                                      ItemsPanel="{StaticResource Hud.HorizontalPanel}" VerticalAlignment="Center" Margin="20,0,0,0"/>
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate DataType="{x:Type local:TeamSwapRowViewModel}">
                <Border Height="76" Background="{Binding Background}" BorderBrush="#59000000" BorderThickness="0,0,0,2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource Sw.Pair}"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="{StaticResource Sw.Gain}"/>
                            <ColumnDefinition Width="{StaticResource Sw.Counters}"/>
                            <ColumnDefinition Width="{StaticResource Sw.CounteredBy}"/>
                            <ColumnDefinition Width="{StaticResource Sw.Strong}"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <local:HeroAvatar Source="{Binding FromIcon}" Width="60" Height="60" CornerRatio="0" ShowPip="False" Dimmed="True"/>
                            <Path Data="M0,0 L16,12 L0,24 Z" Fill="{x:Static local:HudPalette.TextSecondary}" VerticalAlignment="Center" Margin="14,0"/>
                            <local:HeroAvatar Source="{Binding ToIcon}" Width="76" Height="76" CornerRatio="0" ShowPip="False"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,8,0">
                            <TextBlock Text="{Binding ToName}" Style="{StaticResource Hud.Board}" FontSize="38"/>
                            <TextBlock Text="{Binding FromName}" Style="{StaticResource Hud.Board}" FontSize="26"
                                       Foreground="{Binding FromBrush}" FontStyle="Normal" Margin="14,6,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding GainText}" Foreground="{Binding GainBrush}" Style="{StaticResource Hud.BoardStat}"/>
                        <ItemsControl Grid.Column="3" ItemsSource="{Binding Counters}" ItemTemplate="{StaticResource Hud.BoardIcon}"
                                      ItemsPanel="{StaticResource Hud.HorizontalPanel}" VerticalAlignment="Center" Margin="20,0,0,0"/>
                        <ItemsControl Grid.Column="4" ItemsSource="{Binding CounteredBy}" ItemTemplate="{StaticResource Hud.BoardIcon}"
                                      ItemsPanel="{StaticResource Hud.HorizontalPanel}" VerticalAlignment="Center" Margin="20,0,0,0"/>
                        <ItemsControl Grid.Column="5" ItemsSource="{Binding StrongIn}" ItemsPanel="{StaticResource Hud.HorizontalPanel}"
                                      VerticalAlignment="Center" Margin="20,0,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" Style="{StaticResource Hud.Board}"
                                               FontSize="26" Margin="0,0,18,0"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <local:CompositionHeader x:Name="Header" ShowScore="True"/>
        <local:ThreatBar x:Name="Threat"/>

        <!-- Both rosters side by side, like the in-game scoreboard -->
        <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <Border Background="{x:Static local:HudPalette.ColumnBand}" BorderBrush="{x:Static local:HudPalette.Ally}" BorderThickness="8,0,0,0" Height="48">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource Ros.Portrait}"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="{StaticResource Ros.Score}"/>
                            <ColumnDefinition Width="{StaticResource Ros.Icons}"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="YOUR TEAM" Style="{StaticResource Hud.ColumnLabel}"/>
                        <TextBlock Grid.Column="2" Text="SCORE" Style="{StaticResource Hud.ColumnLabel}" HorizontalAlignment="Center" Margin="0"/>
                        <TextBlock Grid.Column="3" Text="COUNTERED BY" Style="{StaticResource Hud.ColumnLabel}"/>
                    </Grid>
                </Border>
                <ItemsControl x:Name="AllyList"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <Border Background="{x:Static local:HudPalette.ColumnBand}" BorderBrush="{x:Static local:HudPalette.Enemy}" BorderThickness="8,0,0,0" Height="48">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource Ros.Portrait}"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="{StaticResource Ros.Score}"/>
                            <ColumnDefinition Width="{StaticResource Ros.Icons}"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="ENEMY" Style="{StaticResource Hud.ColumnLabel}"/>
                        <TextBlock Grid.Column="2" Text="SCORE" Style="{StaticResource Hud.ColumnLabel}" HorizontalAlignment="Center" Margin="0"/>
                        <TextBlock Grid.Column="3" Text="COUNTERS" Style="{StaticResource Hud.ColumnLabel}"/>
                    </Grid>
                </Border>
                <ItemsControl x:Name="EnemyList"/>
            </StackPanel>
        </Grid>

        <!-- Which teammate should swap to what -->
        <Border Background="{x:Static local:HudPalette.ColumnBand}" Height="48" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource Sw.Pair}"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="{StaticResource Sw.Gain}"/>
                    <ColumnDefinition Width="{StaticResource Sw.Counters}"/>
                    <ColumnDefinition Width="{StaticResource Sw.CounteredBy}"/>
                    <ColumnDefinition Width="{StaticResource Sw.Strong}"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Text="TEAM SWAPS" Style="{StaticResource Hud.ColumnLabel}"/>
                <TextBlock Grid.Column="2" Text="GAIN" Style="{StaticResource Hud.ColumnLabel}" HorizontalAlignment="Center" Margin="0"/>
                <TextBlock Grid.Column="3" Text="COUNTERS" Style="{StaticResource Hud.ColumnLabel}"/>
                <TextBlock Grid.Column="4" Text="COUNTERED BY" Style="{StaticResource Hud.ColumnLabel}"/>
                <TextBlock Grid.Column="5" Text="STRONG IN" Style="{StaticResource Hud.ColumnLabel}"/>
            </Grid>
        </Border>
        <ItemsControl x:Name="TeamSwapList"/>
        <Border x:Name="NoTeamSwapsCard" Background="{x:Static local:HudPalette.RowA}" Height="76" Visibility="Collapsed">
            <TextBlock x:Name="NoTeamSwapsText" Style="{StaticResource Hud.Board}" FontSize="32"
                       Foreground="{x:Static local:HudPalette.TextSecondary}" Margin="210,0,0,0"/>
        </Border>
    </StackPanel>
</UserControl>
