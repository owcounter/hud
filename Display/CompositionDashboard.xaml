<UserControl x:Class="Owmeta.Display.CompositionDashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Owmeta.Display">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/OWMetaHUD;component/Display/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <ItemsPanelTemplate x:Key="ThreeColumns">
                <UniformGrid Columns="3"/>
            </ItemsPanelTemplate>

            <!-- Hero header shared by the at-risk and dangerous cards -->
            <DataTemplate x:Key="HeroHeader">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding HeroName}" Style="{StaticResource Hud.HeroName}" FontSize="24"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ScoreText}" Foreground="{Binding ScoreBrush}" Style="{StaticResource Hud.Text}"
                                   FontSize="20" FontWeight="Bold" Margin="0,0,10,0"/>
                        <ItemsControl ItemsSource="{Binding Compositions}" ItemsPanel="{StaticResource Hud.HorizontalPanel}"
                                      ItemTemplate="{StaticResource Hud.CompositionTag}"/>
                    </StackPanel>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ TEAMS + MATCHUP ============ -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <local:TeamCompositionPanel x:Name="BlueTeamPanel" IsBlueTeam="True" Grid.Column="0"/>

            <Border Grid.Column="1" Style="{StaticResource Hud.Panel}" Margin="16,0" Padding="12,16">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="MATCHUP" Style="{StaticResource Hud.RowLabel}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="MatchupDiffText" Text="--" Style="{StaticResource Hud.Score}" FontSize="56"
                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    <Border x:Name="MatchupBadge" Style="{StaticResource Hud.Pill}" HorizontalAlignment="Center" Margin="0,4,0,0">
                        <TextBlock x:Name="MatchupText" Text="NO DATA" Style="{StaticResource Hud.Text}" FontSize="17" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
            </Border>

            <local:TeamCompositionPanel x:Name="RedTeamPanel" IsBlueTeam="False" Grid.Column="2"/>
        </Grid>

        <!-- ============ AT RISK / DANGEROUS ============ -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Hud.Panel}" Padding="20,16,20,8">
                <StackPanel x:Name="VulnerableSection">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Ellipse Width="10" Height="10" Fill="{x:Static local:HudPalette.Bad}" Margin="0,0,10,0"/>
                        <TextBlock Text="TEAMMATES AT RISK" Style="{StaticResource Hud.SectionLabel}" Foreground="{x:Static local:HudPalette.Bad}"/>
                        <TextBlock Text="countered by the enemy team" Style="{StaticResource Hud.Caption}" Margin="10,1,0,0"/>
                    </StackPanel>
                    <ItemsControl x:Name="VulnerableList" ItemsPanel="{StaticResource ThreeColumns}" Margin="-5,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Hud.Card}" Margin="5,0,5,8" Padding="14,12">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <local:HeroAvatar Source="{Binding HeroIcon}" IsHard="{Binding IsHardCountered}"
                                                              Accent="{x:Static local:HudPalette.Bad}"
                                                              Width="54" Height="54" Margin="0,0,14,0"/>
                                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource HeroHeader}"/>
                                        </StackPanel>
                                        <local:AvatarRow Label="COUNTERED BY" Items="{Binding CounteredBy}" Accent="{x:Static local:HudPalette.Bad}"
                                                         AvatarSize="36" LabelWidth="108"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="NoVulnerableText" Text="Nobody on your team is badly countered."
                               Style="{StaticResource Hud.Caption}" Margin="0,0,0,10" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Hud.Panel}" Padding="20,16,20,8">
                <StackPanel x:Name="DangerousSection">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Ellipse Width="10" Height="10" Fill="{x:Static local:HudPalette.Warn}" Margin="0,0,10,0"/>
                        <TextBlock Text="DANGEROUS ENEMIES" Style="{StaticResource Hud.SectionLabel}" Foreground="{x:Static local:HudPalette.Warn}"/>
                        <TextBlock Text="strong into your team" Style="{StaticResource Hud.Caption}" Margin="10,1,0,0"/>
                    </StackPanel>
                    <ItemsControl x:Name="DangerousList" ItemsPanel="{StaticResource ThreeColumns}" Margin="-5,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Hud.Card}" Margin="5,0,5,8" Padding="14,12">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <local:HeroAvatar Source="{Binding HeroIcon}" IsHard="{Binding IsHighThreat}"
                                                              Accent="{x:Static local:HudPalette.Warn}"
                                                              Width="54" Height="54" Margin="0,0,14,0"/>
                                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource HeroHeader}"/>
                                        </StackPanel>
                                        <local:AvatarRow Label="COUNTERS" Items="{Binding Counters}" Accent="{x:Static local:HudPalette.Bad}"
                                                         AvatarSize="36" LabelWidth="108" Margin="0,0,0,6"/>
                                        <local:AvatarRow Label="COUNTERED BY" Items="{Binding CounteredBy}" Accent="{x:Static local:HudPalette.Good}"
                                                         AvatarSize="36" LabelWidth="108"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="NoDangerousText" Text="No enemy is hard countering your team."
                               Style="{StaticResource Hud.Caption}" Margin="0,0,0,10" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ TEAM SWAPS ============ -->
        <Border Grid.Row="2" Style="{StaticResource Hud.Panel}" Padding="20,16,20,8">
            <StackPanel x:Name="TeamSwapSection">
                <Grid Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="TEAM SWAPS" Style="{StaticResource Hud.SectionLabel}" FontSize="22" Foreground="{x:Static local:HudPalette.TextPrimary}"/>
                        <TextBlock x:Name="TeamSwapSummaryText" Style="{StaticResource Hud.Caption}" Margin="16,2,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <local:HeroAvatar Width="22" Height="22" Accent="{x:Static local:HudPalette.TextSecondary}" IsHard="True" RingThickness="1.5" Margin="0,0,8,0"/>
                        <TextBlock Text="thick ring + dot = hard counter" Style="{StaticResource Hud.Caption}" FontSize="16"/>
                    </StackPanel>
                </Grid>

                <ItemsControl x:Name="TeamSwapList" Margin="-5,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="7"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Hud.Card}" Margin="5,0,5,10" Padding="14,10">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <local:HeroAvatar Source="{Binding ToHeroIcon}" Width="56" Height="56" Margin="0,0,12,0"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ToHeroName}" Style="{StaticResource Hud.HeroName}" FontSize="23"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <local:HeroAvatar Source="{Binding FromHeroIcon}" Width="22" Height="22" Dimmed="True" Margin="0,0,6,0"/>
                                                <TextBlock Style="{StaticResource Hud.Caption}" FontSize="15" TextTrimming="CharacterEllipsis">
                                                    <Run Text="for"/>
                                                    <Run Text="{Binding FromHeroName, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="6,-2,0,0">
                                            <TextBlock Text="{Binding ScoreDiff, StringFormat='+{0}'}" Foreground="{Binding ScoreDiffBrush}"
                                                       Style="{StaticResource Hud.Score}" FontSize="32" HorizontalAlignment="Right"/>
                                            <TextBlock Text="GAIN" Style="{StaticResource Hud.RowLabel}" FontSize="13" HorizontalAlignment="Right" Margin="0,-4,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <WrapPanel MinHeight="34">
                                        <ItemsControl ItemsSource="{Binding ToCompositions}" ItemsPanel="{StaticResource Hud.HorizontalPanel}"
                                                      ItemTemplate="{StaticResource Hud.CompositionTag}" Margin="0,0,0,6"/>
                                        <ItemsControl ItemsSource="{Binding ToIncompatibleCompositions}" ItemsPanel="{StaticResource Hud.HorizontalPanel}"
                                                      ItemTemplate="{StaticResource Hud.IncompatibleTag}" Margin="0,0,0,6"/>
                                        <Border Style="{StaticResource Hud.Pill}" Padding="7,3" Margin="0,0,0,6"
                                                Background="{Binding ToMapBackground}" Visibility="{Binding ToMapVisibility}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource Hud.MapIcon}" Fill="{Binding ToMapBrush}" Width="14" Height="14"
                                                      Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding ToMapText}" Foreground="{Binding ToMapBrush}"
                                                           Style="{StaticResource Hud.Text}" FontSize="15" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                    </WrapPanel>

                                    <Rectangle Height="1" Fill="{x:Static local:HudPalette.Divider}" Margin="0,0,0,8"/>
                                    <local:AvatarRow Label="COUNTERS" Items="{Binding Counters}" Accent="{x:Static local:HudPalette.Good}"
                                                     AvatarSize="30" LabelWidth="108" Margin="0,0,0,5"/>
                                    <local:AvatarRow Label="COUNTERED BY" Items="{Binding CounteredBy}" Accent="{x:Static local:HudPalette.Bad}"
                                                     AvatarSize="30" LabelWidth="108" Margin="0,0,0,5"/>
                                    <local:AvatarRow Label="SYNERGY" Items="{Binding Synergies}" Accent="{x:Static local:HudPalette.Info}"
                                                     AvatarSize="30" LabelWidth="108" Margin="0,0,0,5"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="NoTeamSwapsText" Style="{StaticResource Hud.Caption}" FontSize="20" Margin="0,0,0,10" Visibility="Collapsed"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
