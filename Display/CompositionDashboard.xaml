<UserControl x:Class="Owmeta.Display.CompositionDashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Owmeta.Display">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/OWMetaHUD;component/Display/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Dangerous enemy columns -->
            <GridLength x:Key="Th.Portrait">96</GridLength>
            <GridLength x:Key="Th.Name">300</GridLength>
            <GridLength x:Key="Th.Victims">300</GridLength>
            <GridLength x:Key="Th.Answers">330</GridLength>

            <!-- Your team columns -->
            <GridLength x:Key="Tm.Portrait">96</GridLength>
            <GridLength x:Key="Tm.Score">130</GridLength>
            <GridLength x:Key="Tm.Counters">260</GridLength>
            <GridLength x:Key="Tm.CounteredBy">260</GridLength>
            <GridLength x:Key="Tm.Synergy">240</GridLength>
            <GridLength x:Key="Tm.Fits">370</GridLength>
            <GridLength x:Key="Tm.Change">430</GridLength>

            <DataTemplate DataType="{x:Type local:ThreatRowViewModel}">
                <Border Height="88" Background="{Binding Background}" BorderBrush="{Binding EdgeBrush}" BorderThickness="8,0,0,2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource Th.Portrait}"/>
                            <ColumnDefinition Width="{StaticResource Th.Name}"/>
                            <ColumnDefinition Width="{StaticResource Th.Victims}"/>
                            <ColumnDefinition Width="{StaticResource Th.Answers}"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <local:HeroAvatar Source="{Binding Icon}" Width="76" Height="76" CornerRatio="0.06" ShowPip="False"
                                          Accent="{x:Static local:HudPalette.Enemy}" RingThickness="3" Margin="6,0,0,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Hud.Board}" FontSize="44" Margin="24,0,12,0"/>
                        <ItemsControl Grid.Column="2" ItemsSource="{Binding Victims}" ItemTemplate="{StaticResource Hud.BoardIcon}"
                                      ItemsPanel="{StaticResource Hud.HorizontalPanel}" VerticalAlignment="Center"/>
                        <ItemsControl Grid.Column="3" ItemsSource="{Binding AnsweredBy}" ItemTemplate="{StaticResource Hud.BoardIcon}"
                                      ItemsPanel="{StaticResource Hud.HorizontalPanel}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding AnswerVisibility}">
                            <local:HeroAvatar Source="{Binding FromIcon}" Width="62" Height="62" CornerRatio="0.06" ShowPip="False"
                                              Accent="{x:Static local:HudPalette.Bad}" RingThickness="3"/>
                            <TextBlock Text="{Binding FromName}" Style="{StaticResource Hud.Board}" FontSize="38" Margin="16,0,0,0"/>
                            <Path Data="M0,0 L18,13 L0,26 Z" Fill="{x:Static local:HudPalette.TextSecondary}" VerticalAlignment="Center" Margin="18,0"/>
                            <local:HeroAvatar Source="{Binding ToIcon}" Width="62" Height="62" CornerRatio="0.06" ShowPip="False"
                                              Accent="{x:Static local:HudPalette.Good}" RingThickness="3"/>
                            <TextBlock Text="{Binding ToName}" Style="{StaticResource Hud.Board}" FontSize="38" Margin="16,0,14,0"/>
                            <TextBlock Text="{Binding ToScore}" Style="{StaticResource Hud.Board}" FontSize="38" Foreground="{x:Static local:HudPalette.Good}"/>
                            <TextBlock Text="{Binding Hint}" Style="{StaticResource Hud.Board}" FontSize="26" Margin="20,0,0,0"
                                       Foreground="{x:Static local:HudPalette.TextSecondary}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="4" Text="{Binding Note}" Visibility="{Binding NoteVisibility}" Style="{StaticResource Hud.Board}"
                                   FontSize="30" Foreground="{x:Static local:HudPalette.TextSecondary}"/>
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate DataType="{x:Type local:TeamRowViewModel}">
                <Border Height="88" Background="{Binding Background}" BorderBrush="{Binding EdgeBrush}" BorderThickness="8,0,0,2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource Tm.Portrait}"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="{StaticResource Tm.Score}"/>
                            <ColumnDefinition Width="{StaticResource Tm.Counters}"/>
                            <ColumnDefinition Width="{StaticResource Tm.CounteredBy}"/>
                            <ColumnDefinition Width="{StaticResource Tm.Synergy}"/>
                            <ColumnDefinition Width="{StaticResource Tm.Fits}"/>
                            <ColumnDefinition Width="{StaticResource Tm.Change}"/>
                        </Grid.ColumnDefinitions>
                        <local:HeroAvatar Source="{Binding Icon}" Width="76" Height="76" CornerRatio="0.06" ShowPip="False" Margin="6,0,0,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Hud.Board}" FontSize="44" Margin="24,0,12,0"/>
                        <TextBlock Grid.Column="2" Text="{Binding ScoreText}" Foreground="{Binding ScoreBrush}" Style="{StaticResource Hud.Board}"
                                   FontSize="48" HorizontalAlignment="Right" Margin="0,0,28,0"/>
                        <ItemsControl Grid.Column="3" ItemsSource="{Binding Counters}" ItemTemplate="{StaticResource Hud.BoardIcon}"
                                      ItemsPanel="{StaticResource Hud.HorizontalPanel}" VerticalAlignment="Center"/>
                        <ItemsControl Grid.Column="4" ItemsSource="{Binding CounteredBy}" ItemTemplate="{StaticResource Hud.BoardIcon}"
                                      ItemsPanel="{StaticResource Hud.HorizontalPanel}" VerticalAlignment="Center"/>
                        <ItemsControl Grid.Column="5" ItemsSource="{Binding Synergies}" ItemTemplate="{StaticResource Hud.BoardIcon}"
                                      ItemsPanel="{StaticResource Hud.HorizontalPanel}" VerticalAlignment="Center"/>
                        <ItemsControl Grid.Column="6" ItemsSource="{Binding Fits}" ItemTemplate="{StaticResource Hud.FitWord}"
                                      ItemsPanel="{StaticResource Hud.HorizontalPanel}" VerticalAlignment="Center"/>
                        <!-- A long name trims; the arrow, portrait and score always stay visible -->
                        <Grid Grid.Column="7" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,16,0" Visibility="{Binding ChangeVisibility}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Path Data="M0,0 L18,13 L0,26 Z" Fill="{x:Static local:HudPalette.TextSecondary}" VerticalAlignment="Center" Margin="0,0,18,0"/>
                            <local:HeroAvatar Grid.Column="1" Source="{Binding ChangeIcon}" Width="62" Height="62" CornerRatio="0.06" ShowPip="False"
                                              Accent="{x:Static local:HudPalette.Good}" RingThickness="3"/>
                            <TextBlock Grid.Column="2" Text="{Binding ChangeName}" Style="{StaticResource Hud.Board}" FontSize="38" Margin="16,0,14,0"/>
                            <TextBlock Grid.Column="3" Text="{Binding ChangeScore}" Style="{StaticResource Hud.Board}" FontSize="38" Foreground="{x:Static local:HudPalette.Good}"/>
                        </Grid>
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <local:CompositionHeader x:Name="Header"/>

        <!-- Enemies to counter first, each with the swap that answers him -->
        <Border Background="{x:Static local:HudPalette.GroupBand}" Height="52" Margin="0,4,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource Th.Portrait}"/>
                    <ColumnDefinition Width="{StaticResource Th.Name}"/>
                    <ColumnDefinition Width="{StaticResource Th.Victims}"/>
                    <ColumnDefinition Width="{StaticResource Th.Answers}"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.ColumnSpan="2" Text="COUNTER THESE FIRST" Style="{StaticResource Hud.Board}" FontSize="26"
                           Foreground="{x:Static local:HudPalette.Bad}" Margin="24,0,0,0"/>
                <TextBlock Grid.Column="2" Text="COUNTERS YOUR" Style="{StaticResource Hud.Board}" FontSize="26" Foreground="{x:Static local:HudPalette.Bad}"/>
                <TextBlock Grid.Column="3" Text="COUNTERED BY YOUR" Style="{StaticResource Hud.Board}" FontSize="26" Foreground="{x:Static local:HudPalette.Good}"/>
                <TextBlock Grid.Column="4" Text="BEST ANSWER" Style="{StaticResource Hud.Board}" FontSize="26" Foreground="{x:Static local:HudPalette.Good}"/>
            </Grid>
        </Border>
        <ItemsControl x:Name="ThreatList"/>
        <Border x:Name="NoThreatsCard" Background="{x:Static local:HudPalette.RowA}" Height="72" Visibility="Collapsed">
            <TextBlock Text="NO ENEMY COUNTERS YOUR TEAM" Style="{StaticResource Hud.Board}" FontSize="32"
                       Foreground="{x:Static local:HudPalette.TextSecondary}" Margin="120,0,0,0"/>
        </Border>

        <!-- Your team: who counters whom, compositions, and who should change -->
        <Border Background="{x:Static local:HudPalette.GroupBand}" Height="52" Margin="0,4,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource Tm.Portrait}"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="{StaticResource Tm.Score}"/>
                    <ColumnDefinition Width="{StaticResource Tm.Counters}"/>
                    <ColumnDefinition Width="{StaticResource Tm.CounteredBy}"/>
                    <ColumnDefinition Width="{StaticResource Tm.Synergy}"/>
                    <ColumnDefinition Width="{StaticResource Tm.Fits}"/>
                    <ColumnDefinition Width="{StaticResource Tm.Change}"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.ColumnSpan="3" Orientation="Horizontal" Margin="24,0,0,0">
                    <TextBlock Text="YOUR TEAM" Style="{StaticResource Hud.Board}" FontSize="26"/>
                    <TextBlock x:Name="AllyScoreText" Style="{StaticResource Hud.Board}" FontSize="26" Foreground="{x:Static local:HudPalette.Ally}" Margin="14,0,0,0"/>
                    <TextBlock Text="VS" Style="{StaticResource Hud.Board}" FontSize="26" Foreground="{x:Static local:HudPalette.BoardLabel}" Margin="10,0"/>
                    <TextBlock x:Name="EnemyScoreText" Style="{StaticResource Hud.Board}" FontSize="26" Foreground="{x:Static local:HudPalette.Enemy}"/>
                    <TextBlock x:Name="BalanceText" Style="{StaticResource Hud.Board}" FontSize="26" Margin="14,0,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="3" Text="COUNTERS" Style="{StaticResource Hud.Board}" FontSize="26" Foreground="{x:Static local:HudPalette.Good}"/>
                <TextBlock Grid.Column="4" Text="COUNTERED BY" Style="{StaticResource Hud.Board}" FontSize="26" Foreground="{x:Static local:HudPalette.Bad}"/>
                <TextBlock Grid.Column="5" Text="SYNERGY" Style="{StaticResource Hud.Board}" FontSize="26" Foreground="{x:Static local:HudPalette.Ally}"/>
                <TextBlock Grid.Column="6" Text="GOOD · BAD IN" Style="{StaticResource Hud.Board}" FontSize="26" Foreground="{x:Static local:HudPalette.BoardLabel}"/>
                <TextBlock Grid.Column="7" Text="CHANGE TO" Style="{StaticResource Hud.Board}" FontSize="26" Foreground="{x:Static local:HudPalette.BoardLabel}"/>
            </Grid>
        </Border>
        <ItemsControl x:Name="TeamList"/>
    </StackPanel>
</UserControl>
