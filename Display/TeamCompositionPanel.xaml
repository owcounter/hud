<UserControl x:Class="Owmeta.Display.TeamCompositionPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Owmeta.Display">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/OWMetaHUD;component/Display/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Fit meter: one segment per hero (green = fits, grey = neutral, red = conflicts) -->
            <DataTemplate x:Key="FitMeter">
                <ItemsControl ItemsSource="{Binding Segments}" ItemsPanel="{StaticResource Hud.HorizontalPanel}" VerticalAlignment="Center">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="22" Height="8" CornerRadius="2" Margin="0,0,3,0" Background="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource Hud.Panel}" x:Name="MainBorder">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header (full view) -->
            <Grid x:Name="FullHeader" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="TeamAccentBar" Width="4" Height="22" CornerRadius="2" Margin="0,0,12,0"/>
                    <TextBlock x:Name="TeamLabelText" Text="YOUR TEAM" Style="{StaticResource Hud.SectionLabel}" FontSize="22"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="TEAM SCORE" Style="{StaticResource Hud.RowLabel}" Margin="0,0,12,0"/>
                    <TextBlock x:Name="TeamScoreText" Text="--" Style="{StaticResource Hud.Score}" FontSize="30"/>
                </StackPanel>
            </Grid>

            <!-- Compact view (single row strip, used on the F2 swap screen) -->
            <Grid x:Name="CompactView" Grid.Row="1" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,28,0">
                    <Border x:Name="CompactAccentBar" Width="4" Height="40" CornerRadius="2" Margin="0,0,12,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="CompactTeamLabel" Text="YOUR TEAM" Style="{StaticResource Hud.RowLabel}" FontSize="16"/>
                        <TextBlock x:Name="CompactScoreText" Text="--" Style="{StaticResource Hud.Score}" FontSize="28" Margin="0,-2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <ItemsControl x:Name="CompactList" Grid.Column="1" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Viewbox Width="26" Height="26" Margin="0,0,10,0">
                                    <Path Data="{Binding PathData}" Stroke="{Binding Color}" StrokeThickness="2" Stretch="Uniform"/>
                                </Viewbox>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" Foreground="{Binding Color}" Style="{StaticResource Hud.Text}"
                                                   FontSize="22" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding FitText}" Style="{StaticResource Hud.Caption}" FontSize="16"/>
                                    </StackPanel>
                                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource FitMeter}" Margin="0,5,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="CompactEmptyText" Grid.Column="1" Text="No heroes detected yet"
                           Style="{StaticResource Hud.Caption}" Visibility="Collapsed"/>
            </Grid>

            <!-- Full view (one row per composition, used on the F3 dashboard) -->
            <StackPanel Grid.Row="1" x:Name="FullView">
                <ItemsControl x:Name="CompositionList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{x:Static local:HudPalette.Divider}" BorderThickness="0,1,0,0" Padding="0,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Viewbox Width="30" Height="30" Margin="0,0,12,0">
                                            <Path Data="{Binding PathData}" Stroke="{Binding Color}" StrokeThickness="2" Stretch="Uniform"/>
                                        </Viewbox>
                                        <TextBlock Text="{Binding Name}" Foreground="{Binding Color}" Style="{StaticResource Hud.Text}"
                                                   FontSize="26" FontWeight="SemiBold"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource FitMeter}"/>
                                        <TextBlock Text="{Binding FitDescription}" Style="{StaticResource Hud.Caption}" FontSize="15" Margin="0,5,0,0"/>
                                    </StackPanel>

                                    <ItemsControl Grid.Column="2" ItemsSource="{Binding Heroes}" ItemsPanel="{StaticResource Hud.HorizontalPanel}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <local:HeroAvatar Source="{Binding Icon}" Accent="{Binding Accent}" Dimmed="{Binding Dimmed}"
                                                                  Width="48" Height="48" RingThickness="2.5" Margin="8,0,0,0"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="FullEmptyText" Text="No heroes detected yet" Style="{StaticResource Hud.Caption}"
                           Margin="0,8,0,4" Visibility="Collapsed"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
