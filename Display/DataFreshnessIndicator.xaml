<UserControl x:Class="Owmeta.Display.DataFreshnessIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Owmeta.Display">
    <UserControl.Resources>
        <ResourceDictionary Source="/OWMetaHUD;component/Display/Theme.xaml"/>
    </UserControl.Resources>

    <Border x:Name="StatusPill" Style="{StaticResource Hud.Pill}" Background="{x:Static local:HudPalette.Card}" Padding="14,6,16,7">
        <StackPanel Orientation="Horizontal">
            <!-- Status dot -->
            <Ellipse x:Name="StatusDot"
                     Width="10" Height="10"
                     Fill="{x:Static local:HudPalette.Good}"
                     Margin="0,1,10,0"
                     VerticalAlignment="Center"/>

            <!-- Status text -->
            <TextBlock x:Name="StatusText"
                       Text="Updated just now"
                       Style="{StaticResource Hud.Text}"
                       FontSize="18"
                       Foreground="{x:Static local:HudPalette.TextSecondary}"/>
        </StackPanel>
    </Border>
</UserControl>
