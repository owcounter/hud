<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Owmeta.Display">

    <!-- HUD theme. Designed on the 2560x1440 reference canvas used by OverlayWindow.
         Colors live in HudPalette (C#) so code-behind and XAML stay in sync. -->

    <FontFamily x:Key="Hud.DisplayFont">Bahnschrift, Segoe UI</FontFamily>
    <FontFamily x:Key="Hud.BodyFont">Segoe UI</FontFamily>

    <ItemsPanelTemplate x:Key="Hud.HorizontalPanel">
        <StackPanel Orientation="Horizontal"/>
    </ItemsPanelTemplate>

    <!-- Surfaces -->
    <Style x:Key="Hud.Panel" TargetType="Border">
        <Setter Property="Background" Value="{x:Static local:HudPalette.Panel}"/>
        <Setter Property="BorderBrush" Value="{x:Static local:HudPalette.PanelBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="24,20"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="Hud.Card" TargetType="Border">
        <Setter Property="Background" Value="{x:Static local:HudPalette.Card}"/>
        <Setter Property="BorderBrush" Value="{x:Static local:HudPalette.CardBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="16,14"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="Hud.Pill" TargetType="Border">
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="10,3,10,4"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Type scale -->
    <Style x:Key="Hud.Text" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Hud.DisplayFont}"/>
        <Setter Property="Foreground" Value="{x:Static local:HudPalette.TextPrimary}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Section headers: "SWAP OPTIONS", "FOCUS TARGETS"... -->
    <Style x:Key="Hud.SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource Hud.Text}">
        <Setter Property="FontSize" Value="19"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontStretch" Value="SemiCondensed"/>
        <Setter Property="Foreground" Value="{x:Static local:HudPalette.TextSecondary}"/>
    </Style>

    <!-- Row labels inside cards: "BEATS", "WEAK TO"... -->
    <Style x:Key="Hud.RowLabel" TargetType="TextBlock" BasedOn="{StaticResource Hud.Text}">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontStretch" Value="SemiCondensed"/>
        <Setter Property="Foreground" Value="{x:Static local:HudPalette.TextLabel}"/>
    </Style>

    <Style x:Key="Hud.Caption" TargetType="TextBlock" BasedOn="{StaticResource Hud.Text}">
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="Foreground" Value="{x:Static local:HudPalette.TextMuted}"/>
    </Style>

    <Style x:Key="Hud.HeroName" TargetType="TextBlock" BasedOn="{StaticResource Hud.Text}">
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="Hud.Score" TargetType="TextBlock" BasedOn="{StaticResource Hud.Text}">
        <Setter Property="FontSize" Value="34"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontStretch" Value="SemiCondensed"/>
    </Style>

    <Style x:Key="Hud.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Hud.BodyFont}"/>
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="Foreground" Value="{x:Static local:HudPalette.TextSecondary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="TextTrimming" Value="WordEllipsis"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale"/>
    </Style>

    <!-- Composition tags -->
    <DataTemplate x:Key="Hud.CompositionTag">
        <Border Background="{Binding Background}" CornerRadius="5" Padding="9,2,9,3" Margin="0,0,6,0">
            <TextBlock Text="{Binding Name}" Foreground="{Binding Foreground}"
                       Style="{StaticResource Hud.Text}" FontSize="16" FontWeight="SemiBold"/>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="Hud.IncompatibleTag">
        <Border Background="{x:Static local:HudPalette.BadSoft}" CornerRadius="5" Padding="9,2,9,3" Margin="0,0,6,0">
            <TextBlock Text="{Binding Name}" Foreground="{x:Static local:HudPalette.Bad}"
                       Style="{StaticResource Hud.Text}" FontSize="16" FontWeight="SemiBold"
                       TextDecorations="Strikethrough"/>
        </Border>
    </DataTemplate>

    <!-- Key cap, e.g. [F2] -->
    <Style x:Key="Hud.KeyCap" TargetType="Border">
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{x:Static local:HudPalette.PanelBorder}"/>
        <Setter Property="Background" Value="{x:Static local:HudPalette.Card}"/>
        <Setter Property="Padding" Value="8,1,8,2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Scoreboard look: condensed italic caps on solid bands, like the in-game Tab screen -->
    <Style x:Key="Hud.Board" TargetType="TextBlock" BasedOn="{StaticResource Hud.Text}">
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontStretch" Value="Condensed"/>
        <Setter Property="FontStyle" Value="Italic"/>
        <Setter Property="FontSize" Value="40"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="Hud.BoardStat" TargetType="TextBlock" BasedOn="{StaticResource Hud.Text}">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="36"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="Hud.ColumnLabel" TargetType="TextBlock" BasedOn="{StaticResource Hud.Text}">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{x:Static local:HudPalette.ColumnText}"/>
        <Setter Property="Margin" Value="20,0"/>
    </Style>

    <Style x:Key="Hud.StripLabel" TargetType="TextBlock" BasedOn="{StaticResource Hud.ColumnLabel}">
        <Setter Property="Foreground" Value="{x:Static local:HudPalette.BoardLabel}"/>
    </Style>

    <!-- Portrait in a counters / countered-by column: green or red ring, small HARD tag under a hard counter -->
    <DataTemplate x:Key="Hud.BoardIcon">
        <Grid Width="58" Height="76" Margin="0,0,10,0" VerticalAlignment="Center">
            <local:HeroAvatar Source="{Binding Icon}" Accent="{Binding Ring}" RingThickness="4" Visibility="{Binding AvatarVisibility}"
                              ShowPip="False" CornerRatio="0.08" Width="58" Height="58" VerticalAlignment="Top"/>
            <!-- More relations than fit: "+N" in place of the last portrait -->
            <TextBlock Text="{Binding More}" Visibility="{Binding MoreVisibility}" Foreground="{Binding Ring}"
                       Style="{StaticResource Hud.Board}" FontSize="34" VerticalAlignment="Top" Margin="0,8,0,0"/>
            <Border Background="{Binding Ring}" Visibility="{Binding HardVisibility}" CornerRadius="3"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Padding="6,0,6,1">
                <TextBlock Text="HARD" Foreground="{Binding HardText}" FontFamily="{StaticResource Hud.DisplayFont}"
                           FontSize="15" FontWeight="Bold"/>
            </Border>
        </Grid>
    </DataTemplate>

    <!-- Dive / poke / brawl word in a "good in" column -->
    <DataTemplate x:Key="Hud.FitWord">
        <Border Background="{Binding Background}" CornerRadius="3" Padding="9,0,10,2" Margin="0,0,8,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Text}" Foreground="{Binding Foreground}" TextDecorations="{Binding Decorations}"
                       Style="{StaticResource Hud.Board}" FontSize="28"/>
        </Border>
    </DataTemplate>

    <Geometry x:Key="Hud.MapIcon">M15,19L9,16.89V5L15,7.11M20.5,3C20.44,3 20.39,3 20.34,3L15,5.1L9,3L3.36,4.9C3.15,4.97 3,5.15 3,5.38V20.5A0.5,0.5 0 0,0 3.5,21C3.55,21 3.61,21 3.66,20.97L9,18.9L15,21L20.64,19.1C20.85,19 21,18.85 21,18.62V3.5A0.5,0.5 0 0,0 20.5,3Z</Geometry>
</ResourceDictionary>
